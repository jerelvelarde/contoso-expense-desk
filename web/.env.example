# Dashboard build settings. Copy to web/.env.local for local runs; on Railway
# set them as variables on the WEB service (they are passed in as build args).
#
# WARNING: every VITE_* value is inlined into the public JavaScript bundle at
# build time. Anyone who opens the page can read it. Never put a secret here:
# Azure OpenAI / Foundry keys and the CopilotKit Intelligence API key belong on
# the agent service only (see deploy/README.md).
#
# Changing any of these needs a new build, not just a restart.

# Live mode: where the browser reaches the CopilotKit runtime.
#   Hosted on Railway (the web host proxies to the agent): /copilotkit
#   Local .NET host (agent/ExpenseDesk):                   http://localhost:<agent port>/copilotkit
# Leave unset for demo mode: the scripted agent plays the demo in the browser.
# VITE_COPILOTKIT_RUNTIME_URL=/copilotkit

# CopilotKit public license key. Public by design (it ships in the bundle).
# VITE_COPILOTKIT_LICENSE_KEY=

# Optional: shows "Open in CopilotKit Intelligence" on learned rules.
# VITE_INTELLIGENCE_DASHBOARD_URL=

# Demo mode for testers: show the presenter controls, open, on load
# (without ?presenter). Only "true" turns it on.
# VITE_SHOW_DEMO_CONTROLS=true
