# Copy to agent/.env and fill in. Any value can be a 1Password reference
# (op://vault/item/field); ./run.sh resolves them with `op run`, so secrets
# never sit on disk in plain text. Never commit agent/.env.

# Model: an Azure OpenAI or Azure AI Foundry chat deployment (Chat Completions).
# The endpoint is the resource root; /openai/v1/ is added for you.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT
# Leave out to sign in with Entra ID instead (DefaultAzureCredential: az login, managed identity, ...).
AZURE_OPENAI_API_KEY=op://VAULT/ITEM/credential

# No Azure deployment yet? OpenAI's own API stands in through the same SDK path.
# Ignored when AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_DEPLOYMENT are set.
# OPENAI_API_KEY=op://VAULT/ITEM/credential
# OPENAI_MODEL=gpt-5.6-sol
# reasoning_effort for every model call. Defaults to "none" for the OpenAI stand-in, because
# gpt-5.6 models refuse function tools on Chat Completions otherwise. Unset for Azure by default.
# MODEL_REASONING_EFFORT=none

# CopilotKit Intelligence project: server-side API key and the Learning Container
# whose skills the agent loads (and its threads are assigned to). The CopilotKit CLI
# makes both: `npx copilotkit project select --create <name>` (writes the key to .env;
# move it to 1Password) and `npx copilotkit learning containers create --id <id> --name <name>`.
CPK_INTELLIGENCE_API_KEY=op://VAULT/ITEM/credential
CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=YOUR-LEARNING-CONTAINER-ID

# Only for a self-hosted or non-default Intelligence deployment:
# INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
# INTELLIGENCE_RUNNER_URL=wss://realtime.intelligence.copilotkit.ai/runner
# INTELLIGENCE_CLIENT_URL=wss://realtime.intelligence.copilotkit.ai/client
# Pin one learned-skills revision instead of following the latest:
# CPK_INTELLIGENCE_SKILLS_REVISION=

# Host settings (defaults shown).
# DESK_ALLOWED_ORIGINS=http://localhost:4620
# DESK_AGENT_URL=http://localhost:5000/agents/expense
# DESK_DEMO_USER_ID=priya.raman
# DESK_DEMO_USER_NAME=Priya Raman
# DESK_SEED_DIR=../seed
