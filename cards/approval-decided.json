{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "Expenses", "weight": "Bolder", "size": "Small" }] },
        { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "${outcomeLabel}", "color": "${outcomeColor}", "weight": "Bolder", "size": "Small" }] }
      ]
    },
    { "type": "TextBlock", "text": "Hotel in ${city} · ${purpose}", "weight": "Bolder", "size": "Medium", "wrap": true, "spacing": "Medium" },
    { "type": "TextBlock", "text": "You ${outcomeVerb} this for ${requesterName}. I've let ${requesterFirstName} know.", "wrap": true, "spacing": "Small" },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Dates", "value": "${dates} · ${nights} nights" },
        { "title": "Rate", "value": "${nightlyRate} a night" },
        { "title": "Total", "value": "${total}" }
      ]
    },
    { "type": "TextBlock", "text": "${decidedBy} · ${decidedAt}", "isSubtle": true, "size": "Small", "spacing": "Medium" }
  ]
}
